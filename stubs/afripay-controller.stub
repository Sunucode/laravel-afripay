<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use SunuCode\AfriPay\Facades\AfriPay;
use SunuCode\AfriPay\Models\Transaction as AfriPayTransaction;

class AfriPayController extends Controller
{
    /**
     * L'utilisateur revient après un paiement réussi.
     * verifyAndProcess() interroge la passerelle si le webhook n'est pas encore
     * arrivé ; avec trust_webhook_only (défaut), seul le webhook règle le paiement
     * et déclenche PaymentCompleted : la page affiche ce que la passerelle confirme.
     */
    public function success(string $reference)
    {
        $transaction = AfriPayTransaction::where('reference', $reference)->firstOrFail();
        $transaction = AfriPay::verifyAndProcess($transaction);

        if ($transaction->isConfirmedByGateway()) {
            return view('payment.success', compact('transaction'));
        }

        return view('payment.pending', compact('transaction'));
    }

    /**
     * L'utilisateur revient après un paiement échoué ou annulé.
     */
    public function error(string $reference)
    {
        $transaction = AfriPayTransaction::where('reference', $reference)->firstOrFail();

        return view('payment.error', compact('transaction'));
    }
}
